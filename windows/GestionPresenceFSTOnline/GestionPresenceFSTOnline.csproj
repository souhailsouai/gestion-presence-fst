<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gestion-Presence-FST-Windows</AssemblyName>
    <RootNamespace>GestionPresenceFSTOnline</RootNamespace>
    <Version>5.15.0</Version>
    <FileVersion>5.15.0.0</FileVersion>
    <AssemblyVersion>5.15.0.0</AssemblyVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <EmbeddedResource Include="..\..\web\index.html" LogicalName="GestionPresenceFSTOnline.web.index.html" />
  </ItemGroup>
</Project>
