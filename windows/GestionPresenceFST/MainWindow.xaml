<Window x:Class="GestionPresenceFST.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Gestion Présence FST — 2026/2027" Width="1280" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#EEF7FF">
  <Grid>
    <wv2:WebView2 x:Name="Browser" />
    <Border x:Name="OfflinePanel" Background="#F2EEF7FF" Visibility="Collapsed">
      <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Connexion Internet requise" FontSize="28" FontWeight="Bold" Foreground="#092F63" TextAlignment="Center" Margin="0,0,0,12" />
        <TextBlock Text="Impossible d’accéder à l’application en ligne. Vérifiez votre connexion Internet puis réessayez." FontSize="16" Foreground="#526579" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
        <Button Content="Réessayer" Width="150" Height="42" HorizontalAlignment="Center" Click="Retry_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
