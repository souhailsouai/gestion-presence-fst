<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="InstitutionBlue">#092F63</Color>
    <Color x:Key="InstitutionBlue2">#0D5EAF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Canvas">#EEF7FF</Color>
    <Color x:Key="TextPrimary">#172033</Color>
    <SolidColorBrush x:Key="InstitutionBlueBrush" Color="{StaticResource InstitutionBlue}" />
    <SolidColorBrush x:Key="InstitutionBlue2Brush" Color="{StaticResource InstitutionBlue2}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource InstitutionBlue2Brush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
