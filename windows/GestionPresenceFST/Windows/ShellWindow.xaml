<Window x:Class="GestionPresenceFST.Windows.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Présence FST — 2026/2027"
        Width="1320" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource InstitutionBlueBrush}">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Gestion Présence" Foreground="White" FontWeight="Bold" FontSize="22" Margin="8,12,8,28" />
                    <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" Foreground="White">
                        <ListBoxItem Content="Tableau de bord" />
                        <ListBoxItem Content="Classes" />
                        <ListBoxItem Content="Étudiants" />
                        <ListBoxItem Content="Séances" />
                        <ListBoxItem Content="Présence" />
                        <ListBoxItem Content="Rapports" />
                        <ListBoxItem Content="Emploi du temps" />
                        <ListBoxItem Content="Enseignants" />
                        <ListBoxItem Content="Administration" />
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28">
            <Border Background="White" CornerRadius="18" Padding="26">
                <StackPanel>
                    <TextBlock Text="Gestion Présence FST" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InstitutionBlueBrush}" />
                    <TextBlock Text="Shell WPF natif — aucun navigateur intégré" Margin="0,10,0,0" Foreground="#667085" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
