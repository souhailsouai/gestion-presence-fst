<Window x:Class="GestionPresenceFST.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Présence FST — Connexion"
        Width="1040" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource InstitutionBlueBrush}">
            <StackPanel Margin="54" VerticalAlignment="Center">
                <TextBlock Text="FST" FontSize="50" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Gestion des présences" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="0,18,0,0" />
                <TextBlock Text="Faculté des Sciences de Tunis — Université de Tunis El Manar" TextWrapping="Wrap" FontSize="17" Foreground="#DCEAFF" Margin="0,12,0,0" />
                <TextBlock Text="Année universitaire 2026/2027" FontSize="16" Foreground="#DCEAFF" Margin="0,28,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="54">
            <Border Background="White" CornerRadius="18" Padding="36" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Connexion" FontSize="30" FontWeight="Bold" Foreground="{StaticResource InstitutionBlueBrush}" />
                    <TextBlock Text="Application Windows native" Margin="0,8,0,28" Foreground="#667085" />
                    <TextBlock Text="Identifiant" FontWeight="SemiBold" />
                    <TextBox x:Name="UsernameBox" Height="42" Margin="0,6,0,16" Padding="10" />
                    <TextBlock Text="PIN / mot de passe" FontWeight="SemiBold" />
                    <PasswordBox x:Name="CredentialBox" Height="42" Margin="0,6,0,16" Padding="10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <RadioButton x:Name="TeacherMode" Content="Enseignant" IsChecked="True" Margin="0,0,24,0" />
                        <RadioButton x:Name="AdminMode" Content="Administrateur" />
                    </StackPanel>
                    <Button x:Name="LoginButton" Content="Se connecter" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />
                    <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B42318" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
